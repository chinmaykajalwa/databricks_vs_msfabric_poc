# Copy to /etc/p2p/publisher.env, chmod 600. Namespace-level SAS policy (Send) -- NO EntityPath,
# because one producer writes all four hubs. Standard tier or above (Kafka endpoint).
EVENTHUB_BOOTSTRAP=<namespace>.servicebus.windows.net:9093
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
